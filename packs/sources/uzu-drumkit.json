{
  "id": "uzu-drumkit",
  "name": "uzu Drumkit",
  "tagline": "Punchy, analog-processed electronic drums from the TidalCycles community",
  "description": "A small, carefully made electronic kit from the TidalCycles community: synthesized drums by Switch Angel run through an LA-76-style compressor, and modular-synth blips recorded by Ludens and Switch Angel. Kit A is a full electronic kit with alternate hats, kicks and percussion on bank B; Kit B swaps in alternate kicks and snares and puts the modular hits on pads 13–16. Not included: the upstream processed Amen break, the samples contributed by Mot4i (published elsewhere with an attribution request, not under the repo's Unlicense) and two unattributed acoustic files.",
  "tags": [
    "electronic",
    "modern",
    "techno",
    "house",
    "modular",
    "processed"
  ],
  "author": "Switch Angel and Ludens (TidalCycles community)",
